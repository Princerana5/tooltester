{
  "name": "url-tracker-lab-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "URL Tracker Lab backend - test engine, concurrency engine, live monitoring.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx tests/"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "better-sqlite3": "11.7.0",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "socket.io": "4.8.1",
    "undici": "7.2.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "7.6.12",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
